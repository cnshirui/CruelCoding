NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Self-hosted auth: Google OAuth web client (redirect URI: $NEXT_PUBLIC_SITE_URL/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Session cookie signing key, 32+ random characters (openssl rand -base64 48)
AUTH_SECRET=
# Required to apply migrations locally; not used by the web application.
# PostgreSQL connection string from Supabase Connect. Used only by migration/import scripts.
SUPABASE_DB_URL=

# Optional for non-interactive Vercel CLI deployments.
VERCEL_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3400
# Comma-separated emails of the group owner(s) allowed to mark weekly red pockets as sent.
RED_POCKET_ADMIN_EMAILS=
